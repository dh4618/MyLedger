# Copy this file to .env and fill in the two values.
# Supabase Dashboard -> Settings -> API Keys -> "API Keys" tab

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Starts with sb_publishable_
# (Older projects instead have a legacy "anon" key, a long eyJ... string. Either works.)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Server-side only — these are NOT VITE_ prefixed on purpose.
# Vite inlines every VITE_* variable into the public client bundle, so a key with that
# prefix would be readable by anyone. Set these in Vercel, not here, for deploys.
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
